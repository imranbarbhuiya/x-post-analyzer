{
	"name": "x-post-analyzer",
	"displayName": "X Post Analyzer",
	"version": "0.0.1",
	"description": "A chrome extension for x.com that checks your content before allowing you to submit",
	"author": "Parbez <imranbarbhuiya.fsd@gmail.com>",
	"scripts": {
		"dev": "plasmo dev",
		"build": "plasmo build",
		"package": "plasmo package",
		"lint": "eslint --cache --fix .",
		"format": "prettier --write --cache --experimental-cli ."
	},
	"dependencies": {
		"@ai-sdk/openai": "^2.0.136",
		"@plasmohq/storage": "^1.15.0",
		"ai": "^5.0.280",
		"plasmo": "0.90.5",
		"react": "19.1.1",
		"react-dom": "19.1.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@ianvs/prettier-plugin-sort-imports": "4.6.2",
		"@types/chrome": "0.1.4",
		"@types/node": "24.2.1",
		"@types/react": "19.1.10",
		"@types/react-dom": "19.1.7",
		"eslint-config-mahir": "^1.4.1",
		"prettier": "3.6.2",
		"typescript": "5.9.2"
	},
	"manifest": {
		"host_permissions": [
			"https://x.com/*",
			"https://www.x.com/*",
			"https://twitter.com/*",
			"https://www.twitter.com/*"
		]
	},
	"packageManager": "pnpm@10.14.0",
	"pnpm": {
		"overrides": {
			"browserslist": "^4.28.7",
			"msgpackr": "^1.12.1",
			"sharp": "0.35.5",
			"undici": "^6.29.1",
			"vue": "^3.5.44"
		}
	}
}
